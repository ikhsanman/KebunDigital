---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const statusLabel = {
	completed: 'Selesai',
	'in-progress': 'Dalam Pengembangan',
	'on-hold': 'Ditunda',
};

const statusClass = {
	completed: 'status-completed',
	'in-progress': 'status-in-progress',
	'on-hold': 'status-on-hold',
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects - ${SITE_TITLE}`} description="Projects yang pernah dan sedang saya kerjakan" />
		<style>
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 2em;
			}
			.project-card {
				display: flex;
				gap: 1.5em;
				padding: 1em;
				border-radius: 12px;
				background: white;
				box-shadow: var(--box-shadow);
				text-decoration: none;
				color: inherit;
				transition: transform 0.2s ease;
			}
			.project-card:hover {
				transform: translateY(-4px);
			}
			.thumbnail {
				flex-shrink: 0;
				width: 240px;
			}
			.thumbnail img {
				width: 100%;
				height: 160px;
				object-fit: cover;
				border-radius: 8px;
			}
			.project-info {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.5em;
			}
			.project-info h2 {
				margin: 0;
				font-size: 1.5em;
				color: rgb(var(--black));
			}
			.project-card:hover h2 {
				color: var(--accent);
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.description {
				color: rgb(var(--gray-dark));
				line-height: 1.6;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}
			.tag {
				padding: 0.25em 0.75em;
				background: rgb(var(--gray-light));
				border-radius: 999px;
				font-size: 0.8em;
				color: rgb(var(--gray-dark));
			}
			.status {
				padding: 0.25em 0.75em;
				border-radius: 999px;
				font-size: 0.8em;
				font-weight: 600;
			}
			.status-completed {
				background: #dcfce7;
				color: #166534;
			}
			.status-in-progress {
				background: #fef9c3;
				color: #854d0e;
			}
			.status-on-hold {
				background: #fee2e2;
				color: #991b1b;
			}
			@media (max-width: 720px) {
				.project-card {
					flex-direction: column;
				}
				.thumbnail {
					width: 100%;
				}
				.thumbnail img {
					height: 200px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Projects</h1>
			<p>Daftar projects yang pernah dan sedang gua kerjakan.</p>
			<ul>
				{
					projects.map((project) => (
						<li>
							<a href={`/projects/${project.id}/`} class="project-card">
								<div class="thumbnail">
									{project.data.heroImage && (
										<Image width={480} height={320} src={project.data.heroImage} alt="" />
									)}
								</div>
								<div class="project-info">
									<h2>{project.data.title}</h2>
									<span class="date">
										<FormattedDate date={project.data.pubDate} />
									</span>
									<span class="description">{project.data.description}</span>
									<div class="tags">
										<span class={`status ${statusClass[project.data.status]}`}>
											{statusLabel[project.data.status]}
										</span>
										{project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
									</div>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
